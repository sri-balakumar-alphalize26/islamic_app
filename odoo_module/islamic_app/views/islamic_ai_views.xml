<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_islamic_ai_conversation_tree" model="ir.ui.view">
        <field name="name">islamic.ai.conversation.tree</field><field name="model">islamic.ai.conversation</field>
        <field name="arch" type="xml"><list><field name="app_user_id"/><field name="title"/><field name="topic"/><field name="language"/><field name="message_count"/><field name="create_date"/></list></field>
    </record>
    <record id="action_islamic_ai_conversation" model="ir.actions.act_window">
        <field name="name">AI Conversations</field><field name="res_model">islamic.ai.conversation</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_islamic_ai_config_form" model="ir.ui.view">
        <field name="name">islamic.ai.config.form</field><field name="model">islamic.ai.config</field>
        <field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="ai_provider"/><field name="model_name"/><field name="is_active"/></group><group><field name="api_key" password="True"/><field name="api_url"/><field name="max_tokens"/><field name="temperature"/></group></group><group><field name="max_daily_queries_free"/><field name="max_daily_queries_premium"/></group><field name="system_prompt"/></sheet></form></field>
    </record>
    <record id="action_islamic_ai_config" model="ir.actions.act_window">
        <field name="name">AI Configuration</field><field name="res_model">islamic.ai.config</field><field name="view_mode">form</field>
    </record>
    <record id="view_islamic_ai_query_log_tree" model="ir.ui.view">
        <field name="name">islamic.ai.query.log.tree</field><field name="model">islamic.ai.query.log</field>
        <field name="arch" type="xml"><list><field name="app_user_id"/><field name="query"/><field name="tokens_used"/><field name="response_time_ms"/><field name="is_premium_user"/><field name="create_date"/></list></field>
    </record>
    <record id="action_islamic_ai_query_log" model="ir.actions.act_window">
        <field name="name">AI Query Log</field><field name="res_model">islamic.ai.query.log</field><field name="view_mode">list</field>
    </record>
</odoo>

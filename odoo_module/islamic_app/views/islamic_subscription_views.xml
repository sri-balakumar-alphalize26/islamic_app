<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_islamic_subscription_plan_tree" model="ir.ui.view">
        <field name="name">islamic.subscription.plan.tree</field><field name="model">islamic.subscription.plan</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="plan_type"/><field name="price"/><field name="duration_days"/><field name="is_popular"/></list></field>
    </record>
    <record id="action_islamic_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field><field name="res_model">islamic.subscription.plan</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_islamic_subscription_tree" model="ir.ui.view">
        <field name="name">islamic.subscription.tree</field><field name="model">islamic.subscription</field>
        <field name="arch" type="xml"><list><field name="app_user_id"/><field name="plan_id"/><field name="state" widget="badge"/><field name="start_date"/><field name="end_date"/><field name="payment_method"/></list></field>
    </record>
    <record id="action_islamic_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field><field name="res_model">islamic.subscription</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_islamic_payment_tree" model="ir.ui.view">
        <field name="name">islamic.payment.tree</field><field name="model">islamic.payment</field>
        <field name="arch" type="xml"><list><field name="app_user_id"/><field name="amount"/><field name="currency_code"/><field name="payment_method"/><field name="state" widget="badge"/><field name="payment_date"/></list></field>
    </record>
    <record id="action_islamic_payment" model="ir.actions.act_window">
        <field name="name">Payments</field><field name="res_model">islamic.payment</field><field name="view_mode">list,form</field>
    </record>
</odoo>

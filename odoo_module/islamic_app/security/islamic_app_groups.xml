<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_islamic_app" model="ir.module.category">
            <field name="name">Islamic Application</field>
            <field name="sequence">100</field>
        </record>

        <record id="privilege_islamic_app" model="res.groups.privilege">
            <field name="name">Islamic App Access</field>
            <field name="category_id" ref="module_category_islamic_app"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_islamic_app_user" model="res.groups">
            <field name="name">App User</field>
            <field name="privilege_id" ref="privilege_islamic_app"/>
        </record>

        <record id="group_islamic_app_special" model="res.groups">
            <field name="name">Special User</field>
            <field name="privilege_id" ref="privilege_islamic_app"/>
            <field name="implied_ids" eval="[Command.link(ref('group_islamic_app_user'))]"/>
        </record>

        <record id="group_islamic_app_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_islamic_app"/>
            <field name="implied_ids" eval="[Command.link(ref('group_islamic_app_special'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>

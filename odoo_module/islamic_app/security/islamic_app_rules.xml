<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Users can only see their own bookmarks -->
        <record id="rule_bookmark_own" model="ir.rule">
            <field name="name">Own Bookmarks Only</field>
            <field name="model_id" ref="model_islamic_content_bookmark"/>
            <field name="domain_force">[('app_user_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_islamic_app_user'))]"/>
        </record>

        <!-- Users can only see their own dhikr logs -->
        <record id="rule_dhikr_log_own" model="ir.rule">
            <field name="name">Own Dhikr Logs Only</field>
            <field name="model_id" ref="model_islamic_dhikr_log"/>
            <field name="domain_force">[('app_user_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_islamic_app_user'))]"/>
        </record>

        <!-- Users can only see their own notifications -->
        <record id="rule_notification_own" model="ir.rule">
            <field name="name">Own Notifications Only</field>
            <field name="model_id" ref="model_islamic_notification"/>
            <field name="domain_force">[('app_user_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_islamic_app_user'))]"/>
        </record>

        <!-- Users can only see their own AI conversations -->
        <record id="rule_ai_conversation_own" model="ir.rule">
            <field name="name">Own AI Conversations Only</field>
            <field name="model_id" ref="model_islamic_ai_conversation"/>
            <field name="domain_force">[('app_user_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_islamic_app_user'))]"/>
        </record>

        <!-- Users can only see their own family members -->
        <record id="rule_family_member_own" model="ir.rule">
            <field name="name">Own Family Members Only</field>
            <field name="model_id" ref="model_islamic_family_member"/>
            <field name="domain_force">[('app_user_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_islamic_app_user'))]"/>
        </record>

        <!-- Users can only see their own subscription -->
        <record id="rule_subscription_own" model="ir.rule">
            <field name="name">Own Subscription Only</field>
            <field name="model_id" ref="model_islamic_subscription"/>
            <field name="domain_force">[('app_user_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_islamic_app_user'))]"/>
        </record>

        <!-- Admins can see everything -->
        <record id="rule_admin_all_users" model="ir.rule">
            <field name="name">Admin: All App Users</field>
            <field name="model_id" ref="model_islamic_app_user"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_islamic_app_admin'))]"/>
        </record>
    </data>
</odoo>
